SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter LLM (OPENROUTER_API_KEY preferred; LLM_API_KEY also accepted)
OPENROUTER_API_KEY=
LLM_API_KEY=
# Pin a structured-output-capable model. openrouter/free is last-resort fallback only.
LLM_MODEL=openai/gpt-4o-mini
LLM_FALLBACK_MODEL=openrouter/free
LLM_PROVIDER=openrouter
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_REQUESTS_PER_MINUTE=15

# firecrawl | mock  (firecrawl auto-falls back to mock when FIRECRAWL_API_KEY is empty)
FIRECRAWL_API_KEY=
SEARCH_PROVIDER=firecrawl

FRONTEND_URL=http://localhost:3000
ENVIRONMENT=development

# Set to 1 only when you want uvicorn --reload (kills in-flight discovery jobs).
UVICORN_RELOAD=0
MAX_COMPANY_CONCURRENCY=2
MAX_PAGES_PER_COMPANY=3
STALE_RUN_MINUTES=15
SIGNAL_RECHECK_HOURS=24
